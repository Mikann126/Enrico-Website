---
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentProjects, workInProgress, workThemes } from "../data/site";

const defaultTheme = workThemes[0];
---

<BaseLayout title="Current Work" active="Current Work">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Home / Current Work</p>
      <h1 class="hero-title" style="margin-top: 20px;">Current Work</h1>
      <p class="hero-copy" style="margin-top: 10px;">
        Work in progress, active research themes, and draft projects before they become part of the publication archive.
      </p>
    </div>
  </section>

  <section class="container page-content">
    <div class="section-copy">
      <p class="eyebrow small">Active Projects</p>
      <h3>Research currently in motion.</h3>
      <p>
        The page should feel closer to a working research desk than a publication archive:
        fewer items, clearer status, and room for figures or diagrams where they help explain the idea.
      </p>
    </div>

    <article class="active-lead" style="margin-top: 40px;">
      <div class="active-lead-inner">
        <div class="visual-slot">
          <img src="/assets/current-work-graph.png" alt="Research graph placeholder" />
        </div>
        <div>
          <p class="kicker">Working paper / Contingent fees</p>
          <h2 class="project-title">{currentProjects[0].title}</h2>
          <p class="project-authors">{currentProjects[0].authors}</p>
          <p class="body-copy">
            A current project on contingent fees as a less drastic mechanism for addressing liquidity runs.
            The visual slot can later hold EP's own plot or a simplified figure from the draft.
          </p>
          <div class="actions" style="margin-top: 20px;">
            <a class="button" href="#">Working paper</a>
            <a class="button secondary" href="#">Related graph</a>
          </div>
        </div>
      </div>
    </article>

    <div class="grid two" style="margin-top: 30px;">
      {
        currentProjects.slice(1).map((project) => (
          <article class="card small-project">
            <p class="kicker">{project.theme}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <p class="eyebrow small">Work in Progress by Theme</p>
      <h3 id="current-theme-title">{defaultTheme.label}.</h3>
      <p>EP's original work-in-progress archive is organized by theme. This view shows one theme at a time so the page remains readable.</p>
    </div>

    <div class="filters" role="tablist" aria-label="Work in progress themes" style="margin-top: 40px;">
      {
        workThemes.map((theme, index) => (
          <button
            class:list={["filter-button", index === 0 && "active"]}
            type="button"
            data-filter={theme.id}
            data-title={`${theme.label}.`}
            aria-selected={index === 0 ? "true" : "false"}
          >
            {theme.label}
          </button>
        ))
      }
    </div>

    {
      workThemes.map((theme, index) => {
        const items = workInProgress.filter((item) => item.themeId === theme.id);
        return (
          <div class:list={["filter-panel", index === 0 && "active"]} data-panel={theme.id}>
            {items.map((item) => (
              <article class="project-row">
                <span class="status-pill">{item.status}</span>
                <div>
                  <p class="kicker">{theme.label}</p>
                  <h3>{item.title}</h3>
                  {item.authors && <p class="project-authors">{item.authors}</p>}
                </div>
                <div>
                  <p class="summary">{item.summary}</p>
                  <a class="text-link" href="#">Details / PDF</a>
                </div>
              </article>
            ))}
          </div>
        );
      })
    }
  </section>

  <script>
    const filterButtons = document.querySelectorAll("[data-filter]");
    const panels = document.querySelectorAll("[data-panel]");
    const title = document.querySelector("#current-theme-title");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.getAttribute("data-filter");
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-panel") === id));
        if (title) title.textContent = button.getAttribute("data-title") || "Work in progress.";
      });
    });
  </script>
</BaseLayout>
