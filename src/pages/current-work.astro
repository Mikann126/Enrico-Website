---
import BaseLayout from "../layouts/BaseLayout.astro";

type PaperLink = { label: string; url: string };
type Paper = {
  title: string;
  authors: string;
  summary: string;
  links: PaperLink[];
  figure?: boolean;
};
const groups: { id: string; title: string; papers: Paper[] }[] = [
  {
    "id": "banking",
    "title": "Banking, Liquidity & Safety",
    "papers": [
      {
        "title": "Bank Fragility Over the Reserve Cycle",
        "authors": "With Thomas Eisenbach, Rafael Matta, and Spyros Terovitis",
        "summary": "Research on how bank fragility evolves over the reserve cycle.",
        "links": []
      },
      {
        "title": "Liquidity Runs",
        "authors": "With Rafael Matta and Remo Oostdam",
        "summary": "Research on liquidity runs and the incentives behind withdrawals.",
        "links": []
      },
      {
        "title": "Safety via Control",
        "authors": "With Spyros Terovitis",
        "summary": "Research on the relationship between demand for safety and control rights.",
        "links": []
      }
    ]
  },
  {
    "id": "growth",
    "title": "Growth, Intangibles & Inequality",
    "papers": [
      {
        "title": "Creating Intangible Capital",
        "authors": "With Robin Döttling and Tomislav Ladika",
        "summary": "Studies how cash holdings and deferred compensation help innovative firms retain the employees who create intangible assets.",
        "links": [
          {
            "label": "Read paper",
            "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3479152"
          }
        ]
      },
      {
        "title": "Redistributive Growth",
        "authors": "With Robin Döttling",
        "summary": "Examines how a shift towards intangible capital affects inequality, the supply of investable assets, interest rates, and household leverage.",
        "links": [
          {
            "label": "Read paper",
            "url": "https://cepr.org/publications/dp13984"
          }
        ]
      },
      {
        "title": "Secular Trends and Technological Progress",
        "authors": "With Robin Döttling",
        "summary": "Explores how technology that relies on skilled human capital can reduce firms’ financing needs and help explain falling interest rates alongside rising asset values.",
        "links": [
          {
            "label": "Read paper",
            "url": "https://cepr.org/publications/dp12519"
          }
        ]
      },
      {
        "title": "A Structural Trend Break in EU Corporate Leverage",
        "authors": "With Alessandro Zona and Tomislav Ladika",
        "summary": "Research on the structural decline in European corporate leverage.",
        "links": []
      }
    ]
  },
  {
    "id": "climate",
    "title": "Climate, Political Economy & Wellbeing",
    "papers": [
      {
        "title": "Political Economy of Climate Change Adaptation",
        "authors": "With Yasmine van der Straten and Frederick van der Ploeg",
        "summary": "Studies how rising climate risk, inequality, and differences in beliefs reshape voter support for adaptation. Political support can shift abruptly, while investment remains below the social optimum.",
        "links": [
          {
            "label": "Read paper",
            "url": "https://www.ifo.de/en/cesifo/publications/2026/working-paper/political-economy-climate-change-adaptation"
          },
          {
            "label": "PDF",
            "url": "https://www.ifo.de/DocDL/cesifo1_wp10961.pdf"
          }
        ]
      },
      {
        "title": "A Framework for Broad Wellbeing Measurement",
        "authors": "With Nicky Pouw",
        "summary": "Develops a framework for measuring wellbeing across material, relational, and subjective dimensions.",
        "links": []
      }
    ]
  },
  {
    "id": "organizations",
    "title": "Organizations & Institutions",
    "papers": [
      {
        "title": "Lobbying versus Bribing",
        "authors": "With Magda Rola-Janicka and Marcel Vorage",
        "summary": "Research on lobbying, bribery, and political influence.",
        "links": []
      },
      {
        "title": "Resistance to Change",
        "authors": "With James Dow and Luis Garicano",
        "summary": "Examines resistance to organisational change. An earlier draft with James Dow studies how changes in employee rents can impede adaptation to disruptive shifts.",
        "links": [
          {
            "label": "Earlier draft with James Dow",
            "url": "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2356936"
          }
        ]
      }
    ]
  }
];

groups[0].papers.unshift({
  title: "Sand in the Wheels: Addressing Bank Runs through Contingent Fees",
  authors: "With Remo Oostdam and Rafael Matta",
  summary: "Studies how redemption fees triggered by large outflows change withdrawal incentives, and how their allocation affects the balance between run prevention and liquidity provision.",
  links: [{ label: "Public draft: Contingent Fees to Contain Bank Runs", url: "https://elischolar.library.yale.edu/ypfs-documents2/5464/" }],
  figure: true,
});

---

<BaseLayout title="Current Work" active="Current Work">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Enrico C. Perotti</p>
      <h1 class="hero-title work-title">Current Work</h1>
      <p class="hero-copy work-intro">
        Research on financial stability, growth, inequality, and institutions.
      </p>
    </div>
  </section>

  <div class="container work-content">
    <section class="main-section" aria-labelledby="papers-heading">
      <h2 class="main-heading" id="papers-heading">Working Papers</h2>
      <div class="research-groups">
        {groups.map((group) => (
          <section class="research-group" aria-labelledby={`${group.id}-heading`}>
            <h3 class="area-heading" id={`${group.id}-heading`}>{group.title}</h3>
            <div class="paper-list">
              {group.papers.map((paper) => (
                <article class="research-paper">
                  <h4 class="paper-title">
                    {paper.links.length > 0 && !paper.links[0].label.startsWith("Earlier") ? (
                      <a href={paper.links[0].url} target="_blank" rel="noopener noreferrer">{paper.title}</a>
                    ) : paper.title}
                  </h4>
                  <p class="work-authors">{paper.authors}</p>
                  <p class="paper-summary">{paper.summary}</p>
                  {paper.links.length > 0 && (
                    <div class="paper-links">
                      {paper.links.map((link) => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                      ))}
                    </div>
                  )}
                  {paper.figure && (
                    <details class="paper-figure">
                      <summary>View research figure</summary>
                      <figure>
                        <a href="/assets/contingent-fees-figure-1.png" target="_blank" rel="noopener noreferrer" aria-label="Enlarge research figure">
                          <img src="/assets/contingent-fees-figure-1.png" alt="Run thresholds under sequential service and two contingent fee mechanisms, plotted against liquidation value." width="1170" height="963" loading="lazy" />
                        </a>
                        <figcaption>Run thresholds under sequential service and contingent fees. Click to enlarge.</figcaption>
                      </figure>
                    </details>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <div class="work-footer">
      <p>For projects without a public draft, <a href="mailto:e.c.perotti@uva.nl">please contact me</a>.</p>
      <a class="section-more" href="/publications/">Published research ›</a>
    </div>
  </div>
</BaseLayout>

<style>
  .work-title { margin-top: 18px; }
  .work-intro { margin-top: 12px; max-width: 850px; }
  .work-content { padding-top: 30px; padding-bottom: 36px; }
  .main-heading { margin: 0; padding-bottom: 14px; border-bottom: 2px solid #777d70; font-size: 31px; line-height: 1.25; font-weight: 600; }
  .research-group { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 36px; padding: 26px 0; border-bottom: 1px solid #d8d8d0; }
  .research-group:last-child { border-bottom: 0; }
  .area-heading { margin: 0; font-size: 14px; line-height: 1.55; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #59634e; }
  .research-paper { padding: 16px 0; border-top: 1px solid #e5e5df; }
  .research-paper:first-child { padding-top: 0; border-top: 0; }
  .research-paper:last-child { padding-bottom: 0; }
  .paper-title { margin: 0; font-size: 20px; line-height: 1.4; font-weight: 600; }
  .paper-title a { color: inherit; text-decoration: none; }
  .paper-title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .work-authors { margin: 5px 0 0; font-size: 13px; line-height: 1.5; color: #666; }
  .paper-summary { max-width: 850px; margin: 9px 0 0; font-size: 15px; line-height: 1.6; color: var(--neutral-80, #444); }
  .paper-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 9px; }
  .paper-links a, .section-more { color: inherit; font-size: 13px; font-weight: 600; line-height: 1.5; text-decoration: none; }
  .paper-links a:hover, .section-more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .paper-figure { margin-top: 10px; }
  .paper-figure summary { width: fit-content; cursor: pointer; font-size: 13px; color: #555; }
  .paper-figure figure { max-width: 520px; margin: 16px 0 0; }
  .paper-figure img { display: block; width: 100%; height: auto; background: #fff; }
  .paper-figure figcaption { margin-top: 8px; font-size: 12px; line-height: 1.5; color: #666; }
  .work-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; margin-top: 30px; padding-top: 18px; border-top: 1px solid #deded8; }
  .work-footer p { margin: 0; font-size: 13px; line-height: 1.6; color: #666; }
  .work-footer p a { color: inherit; text-underline-offset: 3px; }
  @media (max-width: 800px) {
    .research-group { grid-template-columns: 1fr; gap: 16px; padding: 24px 0; }
    .area-heading { font-size: 13px; }
    .main-heading { font-size: 28px; }
    .paper-title { font-size: 18px; }
    }
</style>
