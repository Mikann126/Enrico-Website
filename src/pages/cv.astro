const affiliations = [
  "Research Fellow, Institute for Law and Finance, Goethe University Frankfurt.",
  "Fellow, European Economic Association; Council Member, 2007–2012.",
  "Member, European Central Bank Research Network Steering Committee, 2002–2006.",
  "CEPR Fellow, Financial Economics and International Economics programmes, since 1996.",
  "Research Fellow, Tinbergen Institute, since 1996.",
  "Member of NBER research groups in corporate finance, risk, macrofinance, and entrepreneurship, since 2003.",
];

const service = [
  "Member of the ESRB Advisory Scientific Committee.",
  "Founder Director of A Sustainable Future, a faculty-wide research grant platform.",
  "Referee for journals including Econometrica, American Economic Review, Journal of Finance, Quarterly Journal of Economics, Journal of Political Economy, Review of Financial Studies, and Journal of Financial Economics.",
  "Conference committee service for the Western Finance Association, European Finance Association, Financial Intermediation Research Society, and Econometric Society.",
];
---

<BaseLayout title="Background & Experience">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Enrico C. Perotti</p>
      <h1 class="hero-title experience-title">
        Background &amp; Experience
      </h1>
      <p class="hero-copy experience-intro">
        Professor of Finance at the Amsterdam Business School,
        University of Amsterdam.
      </p>
    </div>
  </section>

  <div class="container experience-content">
    <section class="experience-section">
      <h2>Research Interests</h2>
      <p class="interests">
        Financial intermediation and regulation; macrofinance and
        long-term growth; political economy; financial and legal
        history; organization theory.
      </p>
    </section>

    {
      sections.map((section) => (
        <section class="experience-section">
          <h2>{section.title}</h2>
          <div class="experience-list">
            {section.items.map((item) => (
              <div class="experience-row">
                <p class="experience-date">{item.date}</p>
                <div>
                  <h3>{item.title}</h3>
                  {item.detail && (
                    <p class="experience-detail">{item.detail}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="experience-section">
      <h2>Fellowships and Affiliations</h2>
      <ul class="experience-bullets">
        {affiliations.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="experience-section">
      <h2>Academic and Professional Service</h2>
      <ul class="experience-bullets">
        {service.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="experience-section">
      <h2>Research and Policy Writing</h2>
      <p class="interests">
        Explore my publications, ongoing research, and policy contributions.
      </p>
      <div class="experience-links">
        <a class="text-link" href="/publications/">
          Publications ›
        </a>
        <a class="text-link" href="/current-work/">
          Current work ›
        </a>
        <a class="text-link" href="/policy-advisory/">
          Policy and advisory work ›
        </a>
        <a
          class="text-link"
          href="https://cepr.org/about/people/enrico-perotti"
          target="_blank"
          rel="noopener noreferrer"
        >
          VoxEU and CEPR writing ›
        </a>
      </div>
    </section>

    <section class="experience-section">
      <h2>Contact</h2>
      <p class="interests">
        Department of Finance, Amsterdam Business School<br />
        University of Amsterdam<br />
        Plantage Muidergracht 12, 1018 TV Amsterdam
      </p>
      <a class="text-link" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .experience-title {
    margin-top: 18px;
    overflow-wrap: break-word;
  }

  .experience-intro {
    max-width: 850px;
    margin-top: 14px;
  }

  .experience-content {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  .experience-section {
    padding: 24px 0;
    border-bottom: 1px solid #deded8;
  }

  .experience-section:last-child {
    border-bottom: 0;
  }

  .experience-section h2 {
    margin: 0 0 18px;
    font-size: 26px;
    line-height: 1.3;
  }

  .interests {
    max-width: 950px;
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--neutral-80, #444);
  }

  .experience-row {
    display: grid;
    grid-template-columns: 185px minmax(0, 1fr);
    gap: 24px;
    padding: 12px 0;
  }

  .experience-date {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--neutral-80, #666);
  }

  .experience-row h3 {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
  }

  .experience-detail {
    margin: 5px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--neutral-80, #555);
  }

  .experience-bullets {
    max-width: 1000px;
    margin: 0;
    padding-left: 20px;
  }

  .experience-bullets li {
    margin-bottom: 10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--neutral-80, #444);
  }

  .experience-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 16px;
  }

  @media (max-width: 700px) {
    .experience-row {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }

    .experience-section h2 {
      font-size: 23px;
    }
  }
</style>
