---
import BaseLayout from "../layouts/BaseLayout.astro";
import { highlights, profile } from "../data/site";

const themes = [
  {
    title: "Banking & Financial Stability",
    description:
      "Bank runs, demand for safety, and the design of regulation and recovery tools.",
    papers: [
      {
        title: "Achieving Safety: Personal, Private, and Public Provision",
        detail: "Journal of Economic Theory, 2025",
        url: "https://doi.org/10.1016/j.jet.2025.105962",
      },
      {
        title: "Capital Forbearance in the Bank Recovery and Resolution Game",
        detail: "Journal of Financial Economics, 2022",
        url: "https://doi.org/10.1016/j.jfineco.2022.09.006",
      },
      {
        title: "Bank Fragility Over the Reserve Cycle",
        detail: "Research in progress · Coauthor's research page",
        url: "https://sites.google.com/site/almeidadamatta/research",
      },
    ],
  },
  {
    title: "Finance & Economic Growth",
    description:
      "How financial systems, corporate financing, and technological change shape investment and growth.",
    papers: [
      {
        title: "The Euro as a Diverse Monetary Union",
        detail: "European Journal of Political Economy, 2026",
        url: "https://doi.org/10.1016/j.ejpoleco.2025.102797",
      },
      {
        title: "Creating Intangible Capital",
        detail: "Working paper",
        url: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3479152",
      },
      {
        title: "Secular Trends and Technological Progress",
        detail: "Working paper",
        url: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3095569",
      },
    ],
  },
  {
    title: "Political Economy & Financial History",
    description:
      "How political incentives and legal institutions shape ownership, financial development, and institutional change.",
    papers: [
      {
        title: "The Political Economy of Corporate Control and Labor Rents",
        detail: "Journal of Political Economy, 2006",
        url: "https://doi.org/10.1086/500278",
      },
      {
        title: "Machiavellian Privatization",
        detail: "American Economic Review, 2002",
        url: "https://doi.org/10.1257/000282802760015694",
      },
      {
        title: "The Emergence of the Corporate Form",
        detail: "Journal of Law, Economics, and Organization, 2017",
        url: "https://doi.org/10.1093/jleo/ewx002",
      },
    ],
  },
  {
    title: "Organizations & Innovation",
    description:
      "How firms and markets support entrepreneurship, exchange ideas, and respond to change.",
    papers: [
      {
        title: "The Circulation of Ideas in Firms and Markets",
        detail: "Management Science, 2011",
        url: "https://doi.org/10.1287/mnsc.1110.1385",
      },
      {
        title: "Entrepreneurs and New Ideas",
        detail: "RAND Journal of Economics, 2008",
        url: "https://doi.org/10.1111/j.1756-2171.2008.00052.x",
      },
      {
        title: "Resistance to Change",
        detail: "Research in progress · Earlier working paper",
        url: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2356936",
      },
    ],
  },
];

const currentPapers = [
  {
    title: "Contingent Fees to Contain Bank Runs",
    authors: "Rafael Matta, Remo Oostdam, and Enrico Perotti",
    venue: "Preliminary draft",
    image: "/assets/contingent-fees-figure-1.png",
    alt: "Run thresholds under sequential service and two contingent fee mechanisms.",
    summary:
      "Fees activated by large deposit outflows can reduce panic-based runs on solvent banks. We show how allocating fee revenues changes withdrawal incentives and liquidity provision, revealing a trade-off between containing runs and meeting depositors' liquidity needs.",
    caption:
      "Figure 1. Contingent fees lower run thresholds relative to standard sequential service. Matta, Oostdam, and Perotti.",
    url: "https://elischolar.library.yale.edu/ypfs-documents2/5464",
  },
  {
    title: "Containing Runs on Solvent Banks: Prioritizing Recovery over Resolution",
    authors: "Edoardo D. Martino and Enrico C. Perotti",
    venue: "Journal of Financial Crises, 2025",
    image: "/assets/containing-runs-figure-6.png",
    alt: "Early recapitalization and redemption charges can support bank recovery.",
    summary:
      "Solvent but undercapitalized banks can face runs before supervisors take effective action. We propose combining early recapitalization through contingent capital with automatic redemption charges during large uninsured deposit outflows, giving viable banks a chance to recover.",
    caption:
      "Figure 6. Interim interventions favoring recovery. Martino and Perotti (2025).",
    url: "https://doi.org/10.17132/2693-3179.1598",
  },
];

const selectedPapers = [
  {
    title: "Achieving Safety: Personal, Private, and Public Provision",
    authors: "Enrico Perotti and Spyros Terovitis",
    venue: "Journal of Economic Theory, 2025",
    image: "/assets/achieving-safety-figure-2.png",
    alt: "Self-insurance and project investment under autarky and the constrained-efficient allocation.",
    summary:
      "A minimum need for safety shapes how households invest. We show how banks can reduce inefficient self-insurance by supplying safe debt, and how government debt and deposit insurance affect private safety provision and aggregate investment in different ways.",
    caption:
      "Figure 2. Reallocating self-insurance toward more efficient providers raises aggregate project investment. Perotti and Terovitis (2025).",
    url: "https://doi.org/10.1016/j.jet.2025.105962",
  },
  {
    title: "Pay, Stay, or Delay? How to Settle a Run",
    authors: "Rafael Matta and Enrico Perotti",
    venue: "Review of Financial Studies, 2024",
    image: "/assets/pay-stay-delay-figure-4.png",
    alt: "Welfare as a function of suspension timing and asset liquidation value.",
    summary:
      "How should a bank settle withdrawals during a run? We compare immediate repayment, suspension, and delayed liquidation. The best rule balances depositors' liquidity needs, fire-sale losses, and incentives to run; discretionary intervention can lead to excessive liquidation and more frequent runs.",
    caption:
      "Figure 4. Welfare depends on suspension timing and asset liquidation value when remaining assets are liquidated after suspension. Matta and Perotti (2024).",
    url: "https://doi.org/10.1093/rfs/hhad084",
  },
  {
    title: "Capital Forbearance in the Bank Recovery and Resolution Game",
    authors: "Natalya Martynova, Enrico Perotti, and Javier Suarez",
    venue: "Journal of Financial Economics, 2022",
    image: "/assets/capital-forbearance-figure-2.png",
    alt: "Multiple equilibria under limited resolution capacity.",
    summary:
      "When intervention is costly, supervisors may struggle to credibly require weak banks to recapitalize. We show how this weakens banks' recovery incentives. Limited resolution capacity can create a too-many-to-resolve outcome, with widespread forbearance and higher systemic costs.",
    caption:
      "Figure 2. A limit on resolution capacity can generate multiple equilibria, including one with no private recovery. Martynova, Perotti, and Suarez (2022).",
    url: "https://doi.org/10.1016/j.jfineco.2022.09.006",
  },
];

const otherPublications = [
  {
    title: "The Euro as a Diverse Monetary Union",
    authors: "with Oscar Soons",
    venue: "European Journal of Political Economy, 2026",
    url: "https://doi.org/10.1016/j.ejpoleco.2025.102797",
  },
  {
    title: "The Good, the Bad and the Missed Boom",
    authors: "with Magda Rola-Janicka",
    venue: "Review of Financial Studies, 2022",
    url: "https://doi.org/10.1093/rfs/hhac014",
  },
  {
    title: "Cheap but Flighty",
    authors: "with Toni Ahnert",
    venue: "Journal of Banking and Finance, 2021",
  },
  {
    title: "Convertible Bank Capital & Risk Incentives",
    authors: "with Natalya Martynova",
    venue: "Journal of Financial Intermediation, 2018",
  },
];

const blogs = [
  {
    outlet: "VoxEU · 2026",
    title: "Building bank resilience by Additional Tier 1 debt reform",
    url: "https://cepr.org/voxeu/columns/building-bank-resilience-additional-tier-1-debt-reform",
  },
];

const policyWorks = [
  {
    outlet: "Systemic Risk Centre",
    title: "Resilience as a Guide for Regulatory Reform",
    url: "https://www.systemicrisk.ac.uk/resilience-guide-regulatory-reform",
  },
  {
    outlet: "CEPR Policy Insight",
    title: "Financial resilience as flood containment",
    url: "https://cepr.org/publications/policy-insight-136-financial-resilience-flood-containment",
  },
  {
    outlet: "SUERF Policy Note · 2023",
    title: "Protect the Safe Core: Restating the Central Bank Mandate",
    url: "https://www.suerf.org/publications/suerf-policy-notes-and-briefs/protect-the-safe-core-restating-the-central-bank-mandate/",
  },
];
---

<BaseLayout title="Home" active="Home">
  <section class="home-band">
    <div class="container">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="eyebrow">Professor of Finance</p>
          <h1 class="hero-title">{profile.name}</h1>
          <p class="hero-copy">{profile.summary}</p>

          <div class="actions">
            <a class="button" href="/cv/">Read the CV</a>
            <a class="button secondary" href="/publications/">
              Browse publications
            </a>
          </div>
        </div>

        <figure class="portrait-panel">
          <img
            src="/assets/enrico-home.jpg.jpg"
            alt="Portrait of Enrico C. Perotti"
          />
        </figure>
      </div>

      <div class="credential-strip">
        {
          highlights.map((item) => (
            <div>
              <p class="credential-value">{item.value}</p>
              <p class="credential-label">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <h2>Research Themes</h2>
    </div>

    <div class="research-theme-grid">
      {
        themes.map((theme) => (
          <article class="research-theme">
            <h3>{theme.title}</h3>
            <p class="theme-description">{theme.description}</p>

            <ul class="theme-paper-list">
              {theme.papers.map((paper) => (
                <li>
                  <p class="theme-paper-title">
                    <a
                      href={paper.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {paper.title}
                    </a>
                  </p>
                  <p class="theme-paper-detail">{paper.detail}</p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div class="section-copy">
        <h2>Current Work on Financial Stability</h2>
      </div>
      <a class="text-link" href="/current-work/">
        See all current work ›
      </a>
    </div>

    <div class="current-papers">
      {
        currentPapers.map((paper) => (
          <article class="card current-paper">
            <figure class="paper-figure">
              <a
                href={paper.image}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Enlarge figure from ${paper.title}`}
              >
                <img src={paper.image} alt={paper.alt} loading="lazy" />
              </a>
              <figcaption>{paper.caption}</figcaption>
            </figure>

            <div class="paper-copy">
              <h3 class="paper-title">
                <a
                  href={paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {paper.title}
                </a>
              </h3>
              <p class="paper-meta">{paper.authors} / {paper.venue}</p>
              <p class="paper-description">{paper.summary}</p>
              <a
                class="text-link"
                href={paper.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the paper ›
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <h2>Publications</h2>
    </div>

    <div class="selected-papers">
      {
        selectedPapers.map((paper) => (
          <article class="publication-row">
            <figure class="paper-figure">
              <a
                href={paper.image}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Enlarge figure from ${paper.title}`}
              >
                <img src={paper.image} alt={paper.alt} loading="lazy" />
              </a>
              <figcaption>{paper.caption}</figcaption>
            </figure>

            <div class="paper-copy">
              <h3 class="paper-title">
                <a
                  href={paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {paper.title}
                </a>
              </h3>
              <p class="paper-meta">{paper.authors} / {paper.venue}</p>
              <p class="paper-description">{paper.summary}</p>
              <a
                class="text-link"
                href={paper.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the paper ›
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <ul class="publication-list">
      {
        otherPublications.map((paper) => (
          <li>
            <p class="list-paper-title">
              {"url" in paper ? (
                <a
                  href={paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {paper.title}
                </a>
              ) : (
                paper.title
              )}
            </p>
            <p class="paper-meta">{paper.authors} / {paper.venue}</p>
          </li>
        ))
      }
    </ul>

    <a class="text-link" href="/publications/">
      See all publications ›
    </a>
  </section>

  <section class="container section">
    <div class="section-copy">
      <h2>Blogs</h2>
      <p>
        Commentary on banking, financial stability, and regulatory reform.
      </p>
    </div>

    <div class="writing-list">
      {
        blogs.map((item) => (
          <article class="writing-item">
            <p class="writing-outlet">{item.outlet}</p>
            <h3>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            </h3>
          </article>
        ))
      }
    </div>

    <a
      class="text-link writing-more"
      href="https://cepr.org/about/people/enrico-perotti"
      target="_blank"
      rel="noopener noreferrer"
    >
      More VoxEU columns and commentary on CEPR ›
    </a>
  </section>

  <section class="container section">
    <div class="section-copy" style="max-width: 1000px;">
      <h2>Policy Work</h2>

      <p>
        Since the early 1990s, I have advised governments, central banks,
        and international institutions on banking reform and financial
        stability, including work with De Nederlandsche Bank, the
        European Central Bank, and the Bank of England.
      </p>

      <p style="margin-top: 16px;">
        Financial stability requires more than capital and liquidity
        buffers. Banks also need credible tools to respond when shocks
        threaten their viability. My work advocates timely supervisory
        intervention, supported by automatic stabilizers that contain
        deposit outflows and give viable banks time to recover.
      </p>
    </div>

    <div class="writing-list">
      {
        policyWorks.map((item) => (
          <article class="writing-item">
            <p class="writing-outlet">{item.outlet}</p>
            <h3>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            </h3>
          </article>
        ))
      }
    </div>

    <a class="text-link writing-more" href="/policy-advisory/">
      More about my policy work ›
    </a>
  </section>
</BaseLayout>

<style>
  .research-theme-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 48px;
    margin-top: 32px;
  }

  .research-theme {
    min-width: 0;
    padding-top: 22px;
    border-top: 1px solid #d5d5ce;
  }

  .research-theme h3 {
    margin: 0 0 12px;
    font-size: 23px;
    line-height: 1.35;
  }

  .theme-description {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--neutral-80, #555);
  }

  .theme-paper-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }

  .theme-paper-list li {
    margin: 0;
    padding: 12px 0;
    border-bottom: 1px solid #ecece7;
  }

  .theme-paper-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .theme-paper-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  .theme-paper-detail {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--neutral-80, #666);
  }

  .theme-paper-title a,
  .list-paper-title a,
  .paper-title a {
    color: inherit;
    text-decoration: none;
  }

  .theme-paper-title a:hover,
  .list-paper-title a:hover,
  .paper-title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .current-papers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .current-paper {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .paper-figure {
    margin: 0;
    min-width: 0;
  }

  .paper-figure a {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .paper-figure img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .current-paper .paper-figure a {
    height: 300px;
    padding: 12px;
    box-sizing: border-box;
  }

  .current-paper .paper-figure img {
    max-height: 100%;
  }

  .paper-figure figcaption {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--neutral-80, #555);
  }

  .paper-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  .paper-copy > * {
    margin: 0;
  }

  .paper-description {
    font-size: 16px;
    line-height: 1.65;
    color: var(--neutral-80, #444);
  }

  .selected-papers {
    margin-top: 36px;
  }

  .publication-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 32px 0;
    border-bottom: 1px solid #deded8;
  }

  .publication-row:first-child {
    padding-top: 0;
  }

  .publication-row .paper-figure a {
    padding: 8px;
  }

  .publication-list {
    list-style: none;
    margin: 28px 0;
    padding: 0;
  }

  .publication-list li {
    padding: 16px 0;
    border-bottom: 1px solid #deded8;
  }

  .publication-list p {
    margin: 0;
  }

  .list-paper-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }

  .publication-list .paper-meta {
    margin-top: 5px;
  }

  .writing-list {
    max-width: 1000px;
    margin-top: 28px;
  }

  .writing-item {
    padding: 22px 0;
    border-top: 1px solid #d5d5ce;
  }

  .writing-outlet {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--neutral-80, #555);
  }

  .writing-item h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.4;
  }

  .writing-item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .writing-item h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .writing-more {
    display: inline-block;
    margin-top: 24px;
  }

  @media (max-width: 800px) {
    .research-theme-grid,
    .current-papers,
    .publication-row {
      grid-template-columns: 1fr;
    }

    .publication-row {
      gap: 24px;
    }

    .current-paper .paper-figure a {
      height: auto;
    }
  }
</style>
