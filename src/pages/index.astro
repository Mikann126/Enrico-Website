---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  featuredPublications,
  highlights,
  profile,
  publicWriting,
  researchThemes,
} from "../data/site";
---

<BaseLayout title="Home" active="Home">
  <section class="home-band">
    <div class="container">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="eyebrow">Professor of Finance</p>
          <h1 class="hero-title">{profile.name}</h1>
          <p class="hero-copy">{profile.summary}</p>

          <div class="actions">
            <a class="button" href="/cv/">Read the CV</a>
            <a class="button secondary" href="/publications/">
              Browse publications
            </a>
          </div>
        </div>

        <figure class="portrait-panel">
          <img
            src="/assets/enrico-home.jpg"
            alt="Portrait of Enrico C. Perotti"
          />
        </figure>
      </div>

      <div class="credential-strip">
        {
          highlights.map((item) => (
            <div>
              <p class="credential-value">{item.value}</p>
              <p class="credential-label">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <h2>Research Themes</h2>
    </div>

    <div class="grid three" style="margin-top: 40px;">
      {
        researchThemes.map((theme) => (
          <article class="card theme-card">
            <span class="theme-mark">{theme.code}</span>
            <h3 class="card-title">{theme.title}</h3>
            <p class="card-text">{theme.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div class="section-copy">
        <h2>Current Work on Financial Stability</h2>
      </div>

      <a class="text-link" href="/current-work/">
        See all current work ›
      </a>
    </div>

    <div class="home-papers">
      <article class="card home-paper">
        <a
          class="home-paper-image"
          href="https://elischolar.library.yale.edu/ypfs-documents2/5464"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Read Contingent Fees to Contain Bank Runs"
        >
          <img
            src="/assets/contingent-fees-figure-1.png"
            alt="Run thresholds under sequential service and two contingent fee mechanisms, plotted against asset liquidation value."
          />
        </a>

        <div class="home-paper-content">
          <h3 class="paper-title">
            Contingent Fees to Contain Bank Runs
          </h3>

          <p class="paper-meta">
            Rafael Matta, Remo Oostdam, and Enrico Perotti /
            Preliminary draft
          </p>

          <p class="card-text">
            Fees activated by large deposit outflows can reduce
            panic-based runs on solvent banks. We show how allocating
            fee revenues changes withdrawal incentives and liquidity
            provision, revealing a trade-off between containing runs
            and meeting depositors' liquidity needs.
          </p>

          <p class="home-figure-caption">
            Figure 1. Contingent fees lower run thresholds relative
            to standard sequential service.
          </p>

          <a
            class="text-link"
            href="https://elischolar.library.yale.edu/ypfs-documents2/5464"
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the paper ›
          </a>
        </div>
      </article>

      <article class="card home-paper">
        <a
          class="home-paper-image"
          href="https://doi.org/10.17132/2693-3179.1598"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Read Containing Runs on Solvent Banks"
        >
          <img
            src="/assets/containing-runs-figure-6.png"
            alt="Diagram showing how early recapitalization and redemption charges can support recovery of solvent but undercapitalized banks."
          />
        </a>

        <div class="home-paper-content">
          <h3 class="paper-title">
            Containing Runs on Solvent Banks:
            Prioritizing Recovery over Resolution
          </h3>

          <p class="paper-meta">
            Edoardo D. Martino and Enrico C. Perotti /
            Journal of Financial Crises, 2025
          </p>

          <p class="card-text">
            Solvent but undercapitalized banks can face runs before
            supervisors take effective action. We propose combining
            early recapitalization through contingent capital with
            automatic redemption charges during large uninsured
            deposit outflows, giving viable banks a chance to recover.
          </p>

          <p class="home-figure-caption">
            Figure 6. Early capital and liquidity interventions
            can favor recovery over runs and bailouts.
          </p>

          <a
            class="text-link"
            href="https://doi.org/10.17132/2693-3179.1598"
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the paper ›
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div class="section-copy">
        <h2>Publications</h2>
      </div>

      <a class="text-link" href="/publications/">
        See all publications ›
      </a>
    </div>

    <div class="grid three">
      {
        featuredPublications.slice(0, 3).map((paper) => (
          <article class="card featured-card">
            <div>
              <span class="pill">{paper.tag}</span>
              <h3 class="paper-title">{paper.title}</h3>
              <p class="paper-meta">
                {paper.authors} / {paper.venue}
                {paper.year ? `, ${paper.year}` : ""}
              </p>
              <p class="paper-summary">{paper.summary}</p>
            </div>
            <div class="visual-slot" aria-hidden="true"></div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-copy" style="max-width: 1200px;">
      <h2>Blogs and Policy Papers</h2>
      <p>
        My policy work spans over three decades, including advisory roles
        at De Nederlandsche Bank, the European Central Bank, and the
        Bank of England. My blogs and policy papers address financial
        stability, banking regulation, and reform.
      </p>
    </div>

    <div class="grid four" style="margin-top: 40px;">
      {
        publicWriting.map((item) => (
          <article class="card public-card">
            <h3 class="card-title">{item.type}</h3>
            <p class="card-text">{item.title}</p>
          </article>
        ))
      }

      <article class="card public-card">
        <h3 class="card-title">Policy Advice</h3>
        <p class="card-text">
          Three decades of advice to governments, central banks,
          and international institutions.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .home-papers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 40px;
  }

  .home-paper {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  .home-paper-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 320px;
    padding: 18px;
    box-sizing: border-box;
    background: #fff;
  }

  .home-paper-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home-paper-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding-top: 24px;
  }

  .home-paper-content > * {
    margin: 0;
  }

  .home-paper-content .card-text {
    font-size: 16px;
    line-height: 1.65;
    color: var(--neutral-80);
  }

  .home-figure-caption {
    font-size: 13px;
    line-height: 1.5;
    color: var(--neutral-80);
  }

  .home-paper-content .text-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 8px;
  }

  @media (max-width: 800px) {
    .home-papers {
      grid-template-columns: 1fr;
    }

    .home-paper-image {
      height: auto;
      padding: 12px;
    }

    .home-paper-image img {
      height: auto;
    }
  }
</style>
