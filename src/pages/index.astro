---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  currentProjects,
  featuredPublications,
  highlights,
  profile,
  publicWriting,
  researchThemes,
} from "../data/site";

const homeProjects = [currentProjects[0], currentProjects[0]];
---

<BaseLayout title="Home" active="Home">
  <section class="home-band">
    <div class="container">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="eyebrow">Professor of Finance</p>
          <h1 class="hero-title">{profile.name}</h1>
          <p class="hero-copy">{profile.summary}</p>
          <div class="actions">
            <a class="button" href="/cv/">Read the CV</a>
            <a class="button secondary" href="/publications/">Browse publications</a>
          </div>
        </div>
        <div class="portrait-panel" aria-label="Portrait placeholder"></div>
      </div>

      <div class="credential-strip">
        {
          highlights.map((item) => (
            <div>
              <p class="credential-value">{item.value}</p>
              <p class="credential-label">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <p class="eyebrow">Research Themes</p>
      <h2>A sustained research agenda on finance, institutions, and stability.</h2>
      <p>
        The site should organize work by intellectual themes, helping readers move from
        broad areas of inquiry to papers, policy writing, and current projects.
      </p>
    </div>
    <div class="grid three" style="margin-top: 40px;">
      {
        researchThemes.map((theme) => (
          <article class="card theme-card">
            <span class="theme-mark">{theme.code}</span>
            <h3 class="card-title">{theme.title}</h3>
            <p class="card-text">{theme.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-copy">
      <p class="eyebrow">Current Work</p>
      <h2>New papers and policy work on financial stability.</h2>
    </div>
    <div class="grid two" style="margin-top: 40px;">
      {
        homeProjects.map((project) => (
          <article class="card work-preview-card">
            <div class="visual-slot">
              <img src="/assets/current-work-graph.png" alt="Research graph placeholder" />
            </div>
            <div>
              <p class="kicker">Contingent fees</p>
              <h3 class="paper-title">{project.title}</h3>
              <p class="paper-meta">{project.authors} / Working paper</p>
              <p class="card-text" style="font-size: 16px; line-height: 25px; color: var(--neutral-80);">
                {project.summary}
              </p>
              <a class="text-link" href="/current-work/">PDF ›</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div class="section-copy">
        <p class="eyebrow">Featured Research</p>
        <h2>Selected papers from the research agenda.</h2>
        <p>
          A few entry points into work on bank regulation, financial stability,
          political economy, and institutional design.
        </p>
      </div>
      <a class="text-link" href="/publications/">See all publications ›</a>
    </div>
    <div class="grid three">
      {
        featuredPublications.slice(0, 3).map((paper) => (
          <article class="card featured-card">
            <div>
              <span class="pill">{paper.tag}</span>
              <h3 class="paper-title">{paper.title}</h3>
              <p class="paper-meta">{paper.authors} / {paper.venue}{paper.year ? `, ${paper.year}` : ""}</p>
              <p class="paper-summary">{paper.summary}</p>
            </div>
            <div class="visual-slot" aria-hidden="true"></div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="section-copy" style="max-width: 1200px;">
      <p class="eyebrow">Public Writing</p>
      <h2>Financial stability research with policy relevance.</h2>
      <p>
        Perotti has contributed to debates on prudential regulation, liquidity risk,
        safe harbor rules, Solvency II, AT1 capital, bank recovery, and stablecoin
        policy through advisory work, policy papers, and public writing.
      </p>
    </div>
    <div class="grid four" style="margin-top: 40px;">
      {
        publicWriting.map((item) => (
          <article class="card public-card">
            <h3 class="card-title">{item.type}</h3>
            <p class="card-text">{item.title}</p>
          </article>
        ))
      }
      <article class="card public-card">
        <h3 class="card-title">Advisory roles</h3>
        <p class="card-text">Work with DNB, ECB / ESRB, Bank of England, and other public institutions.</p>
      </article>
    </div>
  </section>
</BaseLayout>
