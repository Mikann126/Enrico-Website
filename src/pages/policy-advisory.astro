---
import BaseLayout from "../layouts/BaseLayout.astro";
import { policyAdvisoryCards, policyContributions } from "../data/site";
---

<BaseLayout title="Policy & Advisory" active="Policy & Advisory">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Home / Policy & Advisory</p>
      <h1 class="hero-title" style="margin-top: 20px;">Policy & Advisory</h1>
      <p class="hero-copy" style="margin-top: 10px;">
        Policy reports, advisory roles, public writing, and institutional contributions.
      </p>
    </div>
  </section>

  <section class="container page-content">
<div style="max-width: 850px; margin-bottom: 48px;">
  <h2 style="margin-bottom: 20px;">Three decades of policy work</h2>

  <p class="body-copy">
    My policy work began in the early 1990s, advising governments in
    Eastern Europe on privatization and banking reform, alongside visits
    to the IMF and World Bank. From 1997 to 2000, I led banking research
    at the EU-sponsored RECEP centre in Moscow, advising the government
    and central bank during the Russian financial crisis.
  </p>

  <p class="body-copy" style="margin-top: 18px;">
    Since the global financial crisis, my work has focused on financial
    stability and prudential regulation. As an advisor to the Dutch
    Central Bank and a fellow at the Bank of England and European
    Central Bank, I have contributed to debates on liquidity charges,
    Basel III, insurance regulation, and the treatment of financial
    collateral in bankruptcy. A recurring concern is how rules that
    protect individual creditors can increase instability across the
    financial system.
  </p>

  <p class="body-copy" style="margin-top: 18px;">
    My recent work examines contingent capital, timely supervisory
    intervention, and measures to contain runs on banks, money market
    funds, and stablecoins. I advocate automatic stabilizers that
    support early intervention and bank recovery. My current research
    considers AT1 capital reform and the coordination of stablecoin
    regulation across jurisdictions, including the US GENIUS Act and
    the EU’s MiCAR.
  </p>
</div>
    <div class="policy-card-grid">
      {
        policyAdvisoryCards.map((card) => (
          <article class="card policy-overview-card">
            <p class="eyebrow small">{card.eyebrow}</p>
            <h3>{card.title}</h3>
            <p class="body-copy">{card.text}</p>
            <div class="policy-tags">
              {card.tags.map((tag) => <span class="profile-tag">{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section tight">
    <div class="section-copy" style="max-width: 940px;">
      <p class="eyebrow small">Public Writing</p>
      <h3>VoxEU, Financial Times, speeches, interviews, and policy contributions.</h3>
    </div>

    <div style="margin-top: 40px;">
      {
        policyContributions.map((item) => (
          <div class="contribution-row">
            <p class="row-label">{item.type}</p>
            <p>{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
