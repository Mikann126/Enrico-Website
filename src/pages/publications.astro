---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredPublications, publicationThemes, publications, publicWriting } from "../data/site";

const defaultTheme = publicationThemes[0];
const coverColors = ["#3a8ac2", "#c0d9e5", "#b5a81a", "#d8dee8"];
---

<BaseLayout title="Publications" active="Publications">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Home / Publications</p>
      <h1 class="hero-title" style="margin-top: 20px;">Publications</h1>
      <p class="hero-copy" style="margin-top: 10px;">
        Selected articles, academic publications, policy notes, and public writing.
      </p>
    </div>
  </section>

  <section class="container page-content">
    <div class="section-head">
      <div class="section-copy" style="max-width: 660px;">
        <p class="eyebrow small">Featured Articles</p>
        <h3>Selected publications.</h3>
        <p>Placeholder selections for review by Enrico Perotti; the final three can be replaced after content approval.</p>
      </div>
      <a class="text-link" href="/cv/">Full list in CV</a>
    </div>

    <div class="grid three">
      {
        featuredPublications.slice(0, 3).map((paper) => (
          <article class="card featured-card compact">
            <span class="pill">{paper.tag}</span>
            <h3 class="paper-title">{paper.title}</h3>
            <p class="paper-meta">{paper.authors} / {paper.venue}{paper.year ? `, ${paper.year}` : ""}</p>
            <p class="paper-summary">{paper.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container section tight">
    <div class="section-copy" style="max-width: 820px;">
      <p class="eyebrow small">Academic Publications</p>
      <h3 id="publication-theme-title">Browse by research theme.</h3>
      <p>
        The filter keeps the archive organized, while each selected row leaves space for a journal cover,
        PDF thumbnail, or custom paper visual.
      </p>
    </div>

    <div class="filters" role="tablist" aria-label="Publication themes" style="margin-top: 40px;">
      {
        publicationThemes.map((theme, index) => (
          <button
            class:list={["filter-button", index === 0 && "active"]}
            type="button"
            data-filter={theme.id}
            aria-selected={index === 0 ? "true" : "false"}
          >
            {theme.label}
          </button>
        ))
      }
    </div>

    {
      publicationThemes.map((theme, index) => {
        const items = publications.filter((item) => item.themeId === theme.id);
        return (
          <div class:list={["filter-panel", index === 0 && "active"]} data-panel={theme.id}>
            {items.length > 0 ? (
              items.map((item, itemIndex) => (
                <article class="publication-row">
                  <div class="cover-slot" aria-label="Publication cover placeholder">
                    <div class="cover-color" style={`background: ${coverColors[itemIndex % coverColors.length]};`}></div>
                  </div>
                  <div>
                    <p class="pub-venue">{item.venue} · {item.year}</p>
                    <h3 class="paper-title">{item.title}</h3>
                    <p class="project-authors">{item.authors}</p>
                    <p class="paper-summary" style="font-size: 15px; line-height: 24px;">{item.summary}</p>
                    <div class="action-row">
                      {item.links.map((link) => <a class="action-link" href={link.href}>{link.label}</a>)}
                    </div>
                  </div>
                </article>
              ))
            ) : (
              <article class="publication-row">
                <div class="cover-slot" aria-hidden="true"><div class="cover-color" style="background: #d8dee8;"></div></div>
                <div>
                  <p class="pub-venue">{theme.label}</p>
                  <h3 class="paper-title">Entries to be added</h3>
                  <p class="paper-summary" style="font-size: 15px; line-height: 24px;">
                    This row keeps the same publication structure while the final archive is being confirmed.
                  </p>
                </div>
              </article>
            )}
          </div>
        );
      })
    }
  </section>

  <section class="container section tight">
    <div class="section-copy" style="max-width: 840px;">
      <p class="eyebrow small">Policy Notes and Public Writing</p>
      <h3>Policy-facing publications and commentary.</h3>
      <p>
        CEPR policy notes, VOXeu columns, Financial Times writing, and related public-facing work
        are grouped here rather than separated into another main navigation page.
      </p>
    </div>

    <div class="writing-list" style="margin-top: 40px;">
      {
        publicWriting.map((item) => (
          <div class="writing-row">
            <p class="row-label">{item.type}</p>
            <h3>{item.title}</h3>
            <p>{item.meta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll("[data-filter]");
    const panels = document.querySelectorAll("[data-panel]");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.getAttribute("data-filter");
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("active", active);
          item.setAttribute("aria-selected", active ? "true" : "false");
        });
        panels.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-panel") === id));
      });
    });
  </script>
</BaseLayout>
