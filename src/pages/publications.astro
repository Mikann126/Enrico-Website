---

<BaseLayout title="Publications">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Enrico C. Perotti</p>
      <h1 class="hero-title" style="margin-top: 18px;">
        Publications
      </h1>
      <p class="hero-copy" style="margin-top: 12px;">
        Academic articles, book chapters, policy papers, and public writing.
      </p>
    </div>
  </section>

  <div class="container publication-content">
    <nav class="publication-jumps" aria-label="Publication sections">
      <a href="#academic">Academic Articles</a>
      <a href="#other">Other Publications and Chapters</a>
      <a href="#policy-papers">Policy Papers</a>
      <a href="#blogs">VoxEU and Blogs</a>
      <a href="#newspapers">Newspaper Articles</a>
    </nav>

    <section class="publication-section" id="academic">
      <h2>Academic Articles</h2>
      <ol class="publication-entries">
        {
          academicPublications.map((paper) => (
            <li class="publication-entry">
              <p class="publication-year">{paper.year}</p>
              <div>
                <h3>
                  {"url" in paper && paper.url ? (
                    <a
                      href={paper.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {paper.title}
                    </a>
                  ) : (
                    paper.title
                  )}
                </h3>
                {paper.authors && (
                  <p class="publication-authors">{paper.authors}</p>
                )}
                <p class="publication-detail">{paper.venue}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="publication-section" id="other">
      <h2>Other Academic Publications and Book Chapters</h2>
      <ol class="publication-entries">
        {
          otherPublications.map((paper) => (
            <li class="publication-entry">
              <p class="publication-year">{paper.year}</p>
              <div>
                <h3>{paper.title}</h3>
                <p class="publication-detail">{paper.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {
      writingSections.map((section) => (
        <section class="publication-section" id={section.id}>
          <h2>{section.title}</h2>
          <ul class="writing-entries">
            {section.items.map((item) => (
              <li>
                <h3>
                  {"url" in item && item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </h3>
                <p class="publication-detail">{item.detail}</p>
              </li>
            ))}
          </ul>
          {section.id === "blogs" && (
            <a
              class="text-link"
              href="https://cepr.org/about/people/enrico-perotti"
              target="_blank"
              rel="noopener noreferrer"
            >
              More columns and policy writing on CEPR ›
            </a>
          )}
        </section>
      ))
    }

    <section class="publication-section" id="newspapers">
      <h2>Newspaper Articles</h2>
      <ol class="publication-entries">
        {
          newspaperArticles.map((paper) => (
            <li class="publication-entry">
              <p class="publication-year">{paper.year}</p>
              <div>
                <h3>{paper.title}</h3>
                <p class="publication-detail">{paper.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="publication-footer-links">
      <a class="text-link" href="/current-work/">
        Research in progress ›
      </a>
      <a class="text-link" href="/cv/">
        Background &amp; Experience ›
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .publication-content {
    padding-top: 26px;
    padding-bottom: 48px;
  }

  .publication-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid #deded8;
  }

  .publication-jumps a {
    font-size: 14px;
    line-height: 1.5;
    color: inherit;
    text-decoration: none;
  }

  .publication-jumps a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .publication-section {
    padding-top: 34px;
    scroll-margin-top: 100px;
  }

  .publication-section h2 {
    margin: 0 0 18px;
    font-size: 26px;
    line-height: 1.35;
  }

  .publication-entries,
  .writing-entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .publication-entry {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 20px;
    padding: 15px 0;
    border-top: 1px solid #deded8;
  }

  .publication-year {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--neutral-80, #666);
  }

  .publication-entry h3,
  .writing-entries h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
  }

  .publication-entry h3 a,
  .writing-entries h3 a {
    color: inherit;
    text-decoration: none;
  }

  .publication-entry h3 a:hover,
  .writing-entries h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .publication-authors {
    margin: 5px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--neutral-80, #555);
  }

  .publication-detail {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--neutral-80, #555);
  }

  .writing-entries li {
    padding: 15px 0;
    border-top: 1px solid #deded8;
  }

  .publication-section > .text-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
  }

  .publication-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid #deded8;
  }

  @media (max-width: 700px) {
    .publication-entry {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .publication-section h2 {
      font-size: 23px;
