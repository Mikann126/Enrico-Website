---

<BaseLayout title="Publications">
  <section class="page-band">
    <div class="container">
      <p class="eyebrow">Enrico C. Perotti</p>
      <h1 class="hero-title archive-title">Publications</h1>
      <p class="hero-copy archive-intro">
        Academic research, book chapters, policy papers, and public writing.
      </p>
    </div>
  </section>

  <div class="container archive">
    <nav class="archive-nav" aria-label="Publication sections">
      {groups.map((group) => (
        <a href={`#${group.id}`}>{group.title}</a>
      ))}
    </nav>

    <div class="archive-search">
      <label for="publication-search">Find a publication</label>
      <input
        id="publication-search"
        type="search"
        placeholder="Search by title, coauthor, journal, year, or topic"
        aria-controls="publication-results"
      />
      <p class="search-count" aria-live="polite" data-search-count>
        {total} publications
      </p>
    </div>

    <div id="publication-results">
      {groups.map((group) => (
        <section class="archive-group" id={group.id} data-publication-group>
          <h2>{group.title}</h2>
          <ul class="archive-list">
            {group.items.map((paper) => (
              <li
                class="archive-paper"
                data-publication
                data-search={`${paper.title} ${paper.meta} ${paper.summary}`.toLocaleLowerCase()}
              >
                <h3>
                  <a href={paper.url} target="_blank" rel="noopener noreferrer">
                    {paper.title}
                  </a>
                </h3>
                <p class="archive-meta">{paper.meta}</p>
                <p class="archive-summary">{paper.summary}</p>
                <div class="archive-actions">
                  <a href={paper.url} target="_blank" rel="noopener noreferrer">
                    {paper.linkKind === "search" ? "Search for paper ↗" : "Read paper ↗"}
                  </a>
                  {paper.pdf && (
                    <a href={paper.pdf} target="_blank" rel="noopener noreferrer">
                      PDF ↗
                    </a>
                  )}
                  {paper.repository && paper.repository !== paper.url && (
                    <a href={paper.repository} target="_blank" rel="noopener noreferrer">
                      University record ↗
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="no-results" data-no-results hidden>
        No publications match your search. Try another title, name, or topic.
      </p>
    </div>

    <div class="archive-footer">
      <p>
        PDF links open a freely available copy where one has been verified.
        Other links lead to a publisher, repository, or article page;
        access to the final published version may require a subscription.
        “Search for paper” is provided for older items without a confirmed direct link.
      </p>
      <div class="archive-footer-links">
        <a href="/current-work/">Current work ›</a>
        <a href="https://cepr.org/about/people/enrico-perotti" target="_blank" rel="noopener noreferrer">CEPR and VoxEU ›</a>
        <a href="https://www.uva.nl/en/profile/p/e/e.c.perotti/e.c.perotti.html" target="_blank" rel="noopener noreferrer">University publication record ›</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initializePublicationSearch() {
    const input = document.querySelector<HTMLInputElement>("#publication-search");
    if (!input || input.dataset.initialized) return;
    input.dataset.initialized = "true";
    const papers = Array.from(document.querySelectorAll<HTMLElement>("[data-publication]"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-publication-group]"));
    const count = document.querySelector<HTMLElement>("[data-search-count]");
    const empty = document.querySelector<HTMLElement>("[data-no-results]");
    input.addEventListener("input", () => {
      const terms = input.value.toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      papers.forEach((paper) => {
        const haystack = paper.dataset.search || "";
        const matches = terms.every((term) => haystack.includes(term));
        paper.hidden = !matches;
        if (matches) visible++;
      });
      sections.forEach((section) => {
        section.hidden = !section.querySelector("[data-publication]:not([hidden])");
      });
      if (count) count.textContent = `${visible} publication${visible === 1 ? "" : "s"}${terms.length ? " found" : ""}`;
      if (empty) empty.hidden = visible !== 0;
    });
  }
  initializePublicationSearch();
  document.addEventListener("astro:page-load", initializePublicationSearch);
</script>

<style>
  .archive-title { margin-top: 18px; }
  .archive-intro { margin-top: 12px; }
  .archive { padding-top: 24px; padding-bottom: 44px; }
  .archive-nav { display: flex; flex-wrap: wrap; gap: 8px 22px; padding-bottom: 20px; border-bottom: 1px solid #deded8; }
  .archive-nav a, .archive-actions a, .archive-footer-links a { color: inherit; text-decoration: none; }
  .archive-nav a { font-size: 14px; line-height: 1.5; }
  .archive-nav a:hover, .archive-actions a:hover, .archive-footer-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .archive-search { max-width: 720px; margin: 24px 0 8px; }
  .archive-search label { display: block; margin-bottom: 8px; font-size: 15px; font-weight: 600; }
  .archive-search input { display: block; box-sizing: border-box; width: 100%; padding: 11px 14px; border: 1px solid #aaa; border-radius: 4px; font: inherit; font-size: 15px; color: inherit; background: #fff; }
  .search-count { margin: 8px 0 0; font-size: 13px; color: #666; }
  .archive-group { padding-top: 30px; scroll-margin-top: 100px; }
  .archive-group h2 { margin: 0 0 16px; font-size: 26px; line-height: 1.35; }
  .archive-list { list-style: none; padding: 0; margin: 0; }
  .archive-paper { padding: 18px 0; border-top: 1px solid #deded8; }
  .archive-paper h3 { max-width: 1050px; margin: 0; font-size: 19px; line-height: 1.4; font-weight: 600; }
  .archive-paper h3 a { color: inherit; text-decoration: none; }
  .archive-paper h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .archive-meta { max-width: 1050px; margin: 5px 0 0; font-size: 13px; line-height: 1.55; color: #666; }
  .archive-summary { max-width: 1000px; margin: 9px 0 0; font-size: 15px; line-height: 1.65; color: var(--neutral-80, #444); }
  .archive-actions { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 9px; font-size: 13px; font-weight: 600; }
  .archive-footer { margin-top: 30px; padding-top: 20px; border-top: 1px solid #deded8; }
  .archive-footer p { max-width: 950px; font-size: 13px; line-height: 1.6; color: #666; }
  .archive-footer-links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 16px; font-size: 14px; }
  .no-results { padding: 24px 0; }
  [hidden] { display: none !important; }
  @media (max-width: 700px) {
    .archive-group h2 { font-size: 23px; }
    .archive-paper h3 { font-size: 17px; }
    .archive-paper { padding: 15px 0; }
    .archive-summary { font-size: 14px; }
    .archive-nav { gap: 8px 16px; }
  }
</style>
